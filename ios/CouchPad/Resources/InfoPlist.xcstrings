    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad verwendet die Kamera, um den Raum-QR-Code auf deinem Fernseher zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad uses the camera to scan the room QR code shown on your TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad usa la cámara para escanear el código QR de la sala que aparece en tu TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad utilise la caméra pour scanner le QR code de la salle affiché sur ta TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad usa la fotocamera per scansionare il codice QR della stanza mostrato sulla TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPadは、テレビに表示されたルームのQRコードをスキャンするためにカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad는 TV에 표시된 방 QR 코드를 스캔하기 위해 카메라를 사용합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CouchPad usa a câmera para escanear o código QR da sala exibido na sua TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad использует камеру, чтобы отсканировать QR-код комнаты на экране телевизора."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad, TV'nde gösterilen oda QR kodunu taramak için kamerayı kullanır."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad 使用相机扫描电视上显示的房间二维码。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad verbindet sich direkt mit dem Spiel auf deinem Fernseher für die schnellste Steuerung und findet Räume in der Nähe, damit du ohne Code-Scan beitreten kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad connects directly to the game on your TV for the fastest controls, and finds nearby rooms so you can join without scanning a code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad se conecta directamente al juego de tu TV para que los controles respondan al instante y encuentra salas cercanas para que puedas unirte sin escanear un código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad se connecte directement au jeu sur ta TV pour des commandes ultra-réactives et trouve les salons à proximité pour que tu puisses rejoindre sans scanner de code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad si collega direttamente al gioco sulla tua TV per controlli più reattivi e trova le stanze nelle vicinanze così puoi unirti senza scansionare un codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPadは、最速の操作反応のためにテレビのゲームへ直接接続し、コードをスキャンせずに参加できるよう近くのルームを探します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad는 가장 빠른 조작 반응을 위해 TV의 게임에 직접 연결하고, 코드를 스캔하지 않고 참여할 수 있도록 주변 방을 찾습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CouchPad se conecta diretamente ao jogo na sua TV para controles mais rápidos e encontra salas próximas para você entrar sem escanear um código."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad подключается напрямую к игре на телевизоре для максимально быстрого управления и находит комнаты поблизости, чтобы можно было присоединиться без сканирования кода."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad, en hızlı kontroller için TV'ndeki oyuna doğrudan bağlanır ve kod taramadan katılabilmen için yakındaki odaları bulur."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad 会直接连接电视上的游戏以获得最快的操控响应，并查找附近的房间，让你无需扫码即可加入。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
