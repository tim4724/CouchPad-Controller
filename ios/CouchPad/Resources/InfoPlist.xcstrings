    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad verwendet die Kamera, um den Raum-QR-Code auf deinem Fernseher zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad uses the camera to scan the room QR code shown on your TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad usa la cámara para escanear el código QR de la sala que aparece en tu TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
