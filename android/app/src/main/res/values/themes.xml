<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CouchPad" parent="android:Theme.Material.Light.NoActionBar">
        <!-- The frames before Compose draws: launch window + Android 12+ splash.
             The splash does NOT follow windowBackground, so set it explicitly.
             The attribute is API 31+ but harmlessly ignored below, so targetApi
             tells lint that's intentional rather than a NewApi crash risk. -->
        <item name="android:windowBackground">@color/cp_surface</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/cp_surface</item>
    </style>

    <!-- KeyboardSheet's window: transparent, undimmed, and without the platform's dialog
         animation — the sheet animates itself. Transparent bars: this theme family paints
         a black status bar behind its windows, which blacked out the host's bar. -->
    <style name="KeyboardSheetWindow" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>