<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The game-host WebView loads the remote controller + connects to the relay. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the controller's navigator.vibrate() reach the device — WebView haptics
         are a no-op without this. (Normal permission; no runtime request needed.) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Contract §8 room discovery (NearbyRooms.kt). Two permissions, different kinds:
         ACCESS_LOCAL_NETWORK is a DANGEROUS runtime permission (API 36+) and, because we
         target 37, Local Network Protections block mDNS without it — silently, as a UDP
         EPERM with nothing thrown, so a missing grant looks exactly like an empty
         network. Requested from the home screen's "Show rooms nearby" button, never at launch.
         CHANGE_WIFI_MULTICAST_STATE is normal (no runtime request): several OEMs drop
         multicast to the app unless a WifiManager.MulticastLock is held. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Normal permission. Watches whether Wi-Fi/Ethernet is up (lanAvailable) so the
         nearby slot can say "join the Wi-Fi" instead of claiming to search a network
         that isn't there. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app QR scanner (ScanScreen). Camera is optional: manual code entry and
         App Links join fine without one, so don't hide the app from camera-less
         devices on Play. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CouchPad">
        <!-- screenOrientation is the DEFAULT, not a lock: the launcher's own screens are
             portrait, and a game host reverts to this on leave. A controller page that
             asks for landscape (CONTRACT.md §10) overrides it at runtime via
             setRequestedOrientation. -->
        <!-- configChanges: none of these may recreate the activity — recreation destroys
             the game-host WebView and bounces the player's live relay socket.
              - uiMode: a dark-mode flip (incl. scheduled ones). Compose re-themes via
                LocalConfiguration; bar icon contrast is re-applied in onConfigurationChanged.
              - orientation + screenSize/screenLayout/smallestScreenSize: the §10 rotation
                itself. These travel together — a rotation reports all four, so handling
                only `orientation` still recreates. Compose re-lays out and the game host
                re-publishes the safe zone off the new insets. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: a game-domain room URL (system QR scan, shared link, …) opens
                 the app directly — the bare domain and every subdomain. pathPattern
                 "/......" claims exactly-6-char room-code paths, so the homepage/QR
                 display page and any non-6-char page fall through to the browser.
                 pathPattern can't express base58, so a 6-char non-room path would still
                 open the app — JoinResolver rejects it at runtime. autoVerify needs
                 .well-known/assetlinks.json on each verified host. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="hexstacker.com" android:pathPattern="/......" />
                <data android:scheme="https" android:host="*.hexstacker.com" android:pathPattern="/......" />
            </intent-filter>

            <!-- Canonical couchpad.games join links: a room code is the whole path
                 (couchpad.games/<CODE>). pathPattern "/......" claims exactly six
                 characters, so the marketing index and any non-6-char page fall through
                 to the browser. pathPattern can't express base58, so avoid naming a page
                 with a 6-char path — JoinResolver rejects non-room codes at runtime. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="couchpad.games" android:pathPattern="/......" />
                <data android:scheme="https" android:host="*.couchpad.games" android:pathPattern="/......" />
            </intent-filter>

            <!-- Launcher legal pages open in the in-app doc viewer (WebDocScreen),
                 not the join flow — privacy + imprint, default and English. Apex only:
                 preview subdomains don't serve these. Exact paths, so everything else on
                 the apex still routes by the room-code filter above or the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="couchpad.games" android:path="/privacy" />
                <data android:scheme="https" android:host="couchpad.games" android:path="/imprint" />
                <data android:scheme="https" android:host="couchpad.games" android:path="/en/privacy" />
                <data android:scheme="https" android:host="couchpad.games" android:path="/en/imprint" />
            </intent-filter>
        </activity>
    </application>

</manifest>
