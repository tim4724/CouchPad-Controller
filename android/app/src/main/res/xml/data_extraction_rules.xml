<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer. Keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="cp_profile.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="cp_profile.xml" />
    </device-transfer>
</data-extraction-rules>
