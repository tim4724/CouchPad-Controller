    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad sucht nach CouchPad-Spielen auf deinem Fernseher, damit du ohne Code-Scan beitreten kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad looks for CouchPad games on your TV so you can join without scanning a code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad busca partidas de CouchPad en tu TV para que puedas unirte sin escanear un código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CouchPad recherche les parties CouchPad sur ta TV pour que tu puisses rejoindre sans scanner de code."
